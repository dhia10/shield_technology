{
  "openapi": "3.1.0",
  "info": {
    "title": "Shield Technology - Telemetry & Security Intelligence API",
    "description": "Industrial-grade backend for probe ingestion, threat parsing, asynchronous queuing, dead letter routing, and temporal telemetry analytics.",
    "version": "2.4.0"
  },
  "paths": {
    "/api/v1/telemetry/ingest": {
      "post": {
        "tags": [
          "Ingestion Pipeline"
        ],
        "summary": "Ingest Telemetry Logs from Security Probes",
        "operationId": "ingest_telemetry_events_api_v1_telemetry_ingest_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "name": "X-HMAC-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Hmac-Signature"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryIngestRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryIngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry/history": {
      "get": {
        "tags": [
          "Analytical Telemetry"
        ],
        "summary": "Query Telemetry Event History (Cursor-based Pagination)",
        "operationId": "get_telemetry_history_api_v1_telemetry_history_get",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor token for next page",
              "title": "Cursor"
            },
            "description": "Opaque cursor token for next page"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Items per page",
              "default": 50,
              "title": "Limit"
            },
            "description": "Items per page"
          },
          {
            "name": "agent_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by probe/agent ID",
              "title": "Agent Id"
            },
            "description": "Filter by probe/agent ID"
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by severity level (LOW, MEDIUM, HIGH, CRITICAL)",
              "title": "Severity"
            },
            "description": "Filter by severity level (LOW, MEDIUM, HIGH, CRITICAL)"
          },
          {
            "name": "event_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by event type",
              "title": "Event Type"
            },
            "description": "Filter by event type"
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date (ISO 8601)",
              "title": "Start Time"
            },
            "description": "Start date (ISO 8601)"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date (ISO 8601)",
              "title": "End Time"
            },
            "description": "End date (ISO 8601)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry/stats": {
      "get": {
        "tags": [
          "Analytical Telemetry"
        ],
        "summary": "Get Aggregated Threat & Telemetry Stats (Redis Cached)",
        "operationId": "get_telemetry_stats_api_v1_telemetry_stats_get",
        "parameters": [
          {
            "name": "window_hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 720,
              "minimum": 1,
              "description": "Analytical time window in hours",
              "default": 24,
              "title": "Window Hours"
            },
            "description": "Analytical time window in hours"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryStatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "System Observability"
        ],
        "summary": "Health Check & System Observability",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "System Observability"
        ],
        "summary": "Prometheus Metrics Scrape Endpoint",
        "description": "Prometheus exposition format.",
        "operationId": "metrics_endpoint_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry/dlq": {
      "get": {
        "tags": [
          "Ingestion Pipeline"
        ],
        "summary": "Inspect Dead Letter Queue",
        "operationId": "get_dlq_records_api_v1_telemetry_dlq_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry/archive": {
      "post": {
        "tags": [
          "Analytical Telemetry"
        ],
        "summary": "Trigger Batch Archiving & Cryptographic Checksum",
        "operationId": "trigger_archive_api_v1_telemetry_archive_post",
        "parameters": [
          {
            "name": "days_back",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Archive logs older than N days",
              "default": 30,
              "title": "Days Back"
            },
            "description": "Archive logs older than N days"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventTypeEnum": {
        "type": "string",
        "enum": [
          "AUTH_ATTEMPT",
          "SSH_BRUTE_FORCE",
          "PORT_SCAN",
          "MALWARE_DETECTED",
          "DDOS_FLOOD",
          "SYSTEM_HEARTBEAT",
          "FIREWALL_DROP",
          "SQL_INJECTION_ATTEMPT"
        ],
        "title": "EventTypeEnum"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RawTelemetryEvent": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Event creation timestamp (ISO 8601 UTC)"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Agent Id",
            "description": "Unique probe/agent identifier"
          },
          "severity": {
            "$ref": "#/components/schemas/SeverityEnum",
            "description": "Alert severity level",
            "default": "LOW"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventTypeEnum",
            "description": "Categorized security event type"
          },
          "source_ip": {
            "type": "string",
            "maxLength": 45,
            "minLength": 7,
            "title": "Source Ip",
            "description": "Source IP address or hostname"
          },
          "destination_ip": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 45
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination Ip",
            "description": "Target IP address"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload",
            "description": "Arbitrary context data (headers, params, etc.)"
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "event_type",
          "source_ip"
        ],
        "title": "RawTelemetryEvent",
        "description": "Raw incoming telemetry event from monitoring probes / agents.",
        "example": {
          "agent_id": "probe-tunis-dc-01",
          "destination_ip": "10.0.0.5",
          "event_type": "SQL_INJECTION_ATTEMPT",
          "payload": {
            "method": "POST",
            "password": "ClearTextPassword123!",
            "uri": "/api/v1/auth/login",
            "user_agent": "sqlmap/1.7",
            "username": "admin' OR '1'='1"
          },
          "severity": "CRITICAL",
          "source_ip": "197.14.88.22",
          "timestamp": "2026-06-15T10:30:00Z"
        }
      },
      "SeverityEnum": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
        ],
        "title": "SeverityEnum"
      },
      "TelemetryHistoryItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "event_hash": {
            "type": "string",
            "title": "Event Hash"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "source_ip": {
            "type": "string",
            "title": "Source Ip"
          },
          "destination_ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination Ip"
          },
          "sanitized_payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sanitized Payload"
          },
          "enrichment": {
            "additionalProperties": true,
            "type": "object",
            "title": "Enrichment"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "event_hash",
          "timestamp",
          "agent_id",
          "severity",
          "event_type",
          "source_ip",
          "sanitized_payload",
          "created_at"
        ],
        "title": "TelemetryHistoryItem"
      },
      "TelemetryHistoryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TelemetryHistoryItem"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "default": false
          },
          "total_returned": {
            "type": "integer",
            "title": "Total Returned"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total_returned"
        ],
        "title": "TelemetryHistoryResponse"
      },
      "TelemetryIngestRequest": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/RawTelemetryEvent"
            },
            "type": "array",
            "maxItems": 5000,
            "minItems": 1,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "TelemetryIngestRequest",
        "description": "Payload accepted by POST /api/v1/telemetry/ingest (single event or batch)."
      },
      "TelemetryIngestResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "accepted"
          },
          "accepted_count": {
            "type": "integer",
            "title": "Accepted Count"
          },
          "queue_name": {
            "type": "string",
            "title": "Queue Name"
          },
          "dropped_count": {
            "type": "integer",
            "title": "Dropped Count",
            "default": 0
          },
          "ingest_latency_ms": {
            "type": "number",
            "title": "Ingest Latency Ms"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "accepted_count",
          "queue_name",
          "ingest_latency_ms"
        ],
        "title": "TelemetryIngestResponse"
      },
      "TelemetryStatsResponse": {
        "properties": {
          "window_hours": {
            "type": "integer",
            "title": "Window Hours"
          },
          "total_events": {
            "type": "integer",
            "title": "Total Events"
          },
          "by_severity": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Severity"
          },
          "by_event_type": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Event Type"
          },
          "top_source_ips": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Top Source Ips"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit",
            "default": false
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "window_hours",
          "total_events",
          "by_severity",
          "by_event_type",
          "top_source_ips"
        ],
        "title": "TelemetryStatsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}