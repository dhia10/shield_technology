# ==============================================================================
# Shield Technology Data & AI Platform - Environment Configuration Template
# ZERO-SECRETS POLICY: Never commit production values, keys, or passwords to git.
# Copy this file to .env before starting: cp .env.example .env
# ==============================================================================

# Application & Environment
APP_NAME="Shield Technology Data & AI Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG="false"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Telemetry Ingestion Parameters
TELEMETRY_BUFFER_CAPACITY=1000
TELEMETRY_BATCH_FLUSH_SIZE=50
TELEMETRY_FLUSH_INTERVAL_SECONDS=5.0

# Vector Embeddings & Similarity Search
EMBEDDING_MODEL="all-MiniLM-L6-v2"
VECTOR_DIMENSION=384
DEFAULT_CONFIDENCE_THRESHOLD=0.25

# Local Storage Paths (Protected by .gitignore)
DATA_DIR="data"
SQLITE_DB_PATH="data/shield_telemetry.db"

# External Webhook Dispatch (e.g., n8n, Slack, CRM)
# Set MOCK_WEBHOOKS=false in production to enable live HTTP dispatch
MOCK_WEBHOOKS="true"
N8N_DISPATCH_WEBHOOK_URL="https://n8n.your-domain.internal/webhook/shield-lead-dispatch"
WEBHOOK_SIGNING_SECRET="replace_with_hex_hmac_secret_32_chars_min"
WEBHOOK_TIMEOUT_SECONDS=4.0
