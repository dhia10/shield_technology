# ==============================================================================
# Shield Technology Strict Security .gitignore
# Zero-Secret Architecture & Public Repository Sanitization Rules
# ==============================================================================

# Environment files & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Python Artifacts & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Quality Assurance
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Data, SQLite databases & Embedded Vector indices
data/
*.db
*.sqlite
*.sqlite3
data/raw/*
data/processed/*

# Log files & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node dependencies (Legacy archive)
node_modules/

# OS and Editor specific
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
.azure/
deploy.cmd
*.zip
